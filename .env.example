# PARKER settings and their defaults.
#
# PARKER does not load this file automatically yet. To change a setting for the
# current PowerShell window, use for example:
#     $env:PARKER_VOICE_LEAD_IN = "1.5"
# Never put passwords or API keys in this example file.

# --- Personality ---
# What PARKER calls you
PARKER_OWNER_NAME=Raunak
# How the voice should say it (British rules misread some names).
# Hear the options with: python -m backend.speech_output --names
PARKER_OWNER_SPOKEN=Rawnak

# --- File search ---
# Extra folders to search besides Documents, Downloads, Desktop, Pictures, Music
# and Videos; separate several with ; on Windows
# PARKER_SEARCH_FOLDERS=D:\Projects;D:\University

# --- Desktop app ---
# Talk from any app (also changeable in the app's settings menu)
# PARKER_HOTKEY=Ctrl+Alt+P

# --- Brain (Ollama) ---
PARKER_OLLAMA_URL=http://localhost:11434
PARKER_MODEL=qwen3.5:4b

# --- Voice output (Piper) ---
PARKER_VOICE=en_GB-alba-medium
# Folder with the .onnx voice files (default: voices/ in the project folder)
# PARKER_VOICES_DIR=
# stream: always-open audio stream, speaks sentence by sentence (default)
# winsound: older whole-reply playback
PARKER_AUDIO=stream
# 1.0 = normal pace, 0.9 = a little slower, 1.1 = a little faster
PARKER_VOICE_SPEED=1.0
# Rhythm variation between words: 0.8 sounds most natural for Alba
PARKER_VOICE_VARIATION=0.8
# Seconds of silence before each reply (default 0.2 for stream, 1.0 for winsound)
# PARKER_VOICE_LEAD_IN=

# --- Long-term memory and agenda (SQLite) ---
# Default: memory/parker.db in the project folder (ignored by Git)
# PARKER_MEMORY_DB=

# --- Voice input (Faster-Whisper) ---
PARKER_STT_MODEL=small.en
# cpu or cuda
PARKER_STT_DEVICE=cpu
# int8 for CPU; float16 for cuda
PARKER_STT_COMPUTE=int8
# Hands-free: seconds of quiet that end your message, and how long to wait for you to speak
# PARKER_END_SILENCE=1.2
# PARKER_LISTEN_WAIT=8

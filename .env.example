# PARKER settings and their defaults.
#
# PARKER does not load this file automatically yet. To change a setting for the
# current PowerShell window, use for example:
#     $env:PARKER_VOICE_LEAD_IN = "1.5"
# Never put passwords or API keys in this example file.

# --- Personality ---
# What PARKER calls you
PARKER_OWNER_NAME=Raunak

# --- Brain (Ollama) ---
PARKER_OLLAMA_URL=http://localhost:11434
PARKER_MODEL=qwen3.5:4b

# --- Voice output (Piper) ---
PARKER_VOICE=en_GB-alba-medium
# Folder with the .onnx voice files (default: voices/ in the project folder)
# PARKER_VOICES_DIR=
# Seconds of silence before each reply so the audio device wakes in time
PARKER_VOICE_LEAD_IN=1.0

# --- Long-term memory and agenda (SQLite) ---
# Default: memory/parker.db in the project folder (ignored by Git)
# PARKER_MEMORY_DB=

# --- Voice input (Faster-Whisper) ---
PARKER_STT_MODEL=small.en
# cpu or cuda
PARKER_STT_DEVICE=cpu
# int8 for CPU; float16 for cuda
PARKER_STT_COMPUTE=int8
